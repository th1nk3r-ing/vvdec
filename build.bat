@echo off
setlocal enabledelayedexpansion

rem Locate Visual Studio via vswhere (ships with VS Installer)
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" set "VSWHERE=%ProgramFiles%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" (
  echo ERROR: vswhere.exe not found. Please install Visual Studio.
  exit /b 1
)

for /f "usebackq tokens=*" %%i in (`"%VSWHERE%" -latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSINSTALL=%%i"
if not defined VSINSTALL (
  echo ERROR: No Visual Studio with VC++ tools found.
  exit /b 1
)

call "%VSINSTALL%\VC\Auxiliary\Build\vcvars64.bat"

set "BUILD_DIR=build"
set "ASAN=0"

if /i "%~1"=="--asan" (
    set "BUILD_DIR=build-asan"
    set "ASAN=1"
)
if /i "%~1"=="--help" (
    echo Usage: build.bat [--asan]
    echo   ^(no args^)  Normal build, output to build\
    echo   --asan     MSVC AddressSanitizer build, output to build-asan\
    exit /b 0
)

rem Switch to script directory (so build/ is created next to build.bat)
cd /d "%~dp0"

if not exist "%BUILD_DIR%" mkdir "%BUILD_DIR%"
cd "%BUILD_DIR%"

set "CMAKE_FLAGS=-G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DVVDEC_LIBRARY_ONLY=OFF -DVVDEC_ENABLE_INTERNALS=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_CXX_FLAGS="/wd4819" -DCMAKE_C_FLAGS="/wd4819""

if "%ASAN%"=="1" (
    rem MSVC ASan requires debug info (/Zi) to avoid C5072 warning, which is
    rem promoted to error by VVDEC_ENABLE_WERROR. We add /Zi and disable WERROR.
    rem VVDEC_TOPLEVEL_OUTPUT_DIRS=OFF keeps ASan artifacts below the build dir,
    rem so they do not overwrite the normal build in bin\release-shared.
    echo [ASan] /fsanitize:address + /Zi enabled, building to %BUILD_DIR%\
    set "CMAKE_FLAGS=%CMAKE_FLAGS% -DVVDEC_USE_ADDRESS_SANITIZER=ON -DVVDEC_TOPLEVEL_OUTPUT_DIRS=OFF -DVVDEC_ENABLE_WERROR=OFF -DCMAKE_CXX_FLAGS="/wd4819 /Zi" -DCMAKE_C_FLAGS="/wd4819 /Zi" -DCMAKE_EXE_LINKER_FLAGS="/DEBUG" -DCMAKE_SHARED_LINKER_FLAGS="/DEBUG""
)

rem Always re-run CMake so cache changes (e.g. VVDEC_TOPLEVEL_OUTPUT_DIRS)
rem are applied when reusing an existing build directory.
cmake %CMAKE_FLAGS% ..
if errorlevel 1 (
    echo ERROR: CMake configuration failed.
    pause
    exit /b 1
)

rem Build the shared library and the CLI app (Ninja parallelizes automatically)
cmake --build . --target vvdec vvdecapp
if errorlevel 1 (
    echo ERROR: Build failed.
    pause
    exit /b 1
)

rem YUView expects vvdecLib.dll, but CMake target name is vvdec.
rem Normal builds put vvdec.dll into bin\release-shared, ASan builds (with
rem VVDEC_TOPLEVEL_OUTPUT_DIRS=OFF) into the build dir's bin\.
if "%ASAN%"=="1" (
    set "DLL_SRC=%CD%\bin\vvdec.dll"
) else (
    set "DLL_SRC=%CD%\..\bin\release-shared\vvdec.dll"
)
if not exist "!DLL_SRC!" (
    echo ERROR: vvdec.dll not found at "!DLL_SRC!"
    echo        Check the CMake output directory configuration.
    exit /b 1
)
copy /y "!DLL_SRC!" vvdecLib.dll >nul
echo Copied: !DLL_SRC! -^> vvdecLib.dll

if "%ASAN%"=="1" (
    rem Deploy the MSVC ASan dynamic runtime DLL next to vvdecapp.exe (build\bin)
    rem so it can run without the host process being ASan-instrumented.
    set "ASAN_DLL_SRC=%VCToolsInstallDir%bin\Hostx64\x64\clang_rt.asan_dynamic-x86_64.dll"
    if not exist "!ASAN_DLL_SRC!" (
        echo ERROR: !ASAN_DLL_SRC! not found, cannot deploy the ASan runtime next to vvdecapp.exe
        exit /b 1
    )
    copy /y "!ASAN_DLL_SRC!" "bin\clang_rt.asan_dynamic-x86_64.dll" >nul
    echo [ASan] Deployed clang_rt.asan_dynamic-x86_64.dll -^> bin\

    rem Generate run-asan.bat next to vvdecapp.exe. MSVC ASan writes its report
    rem to the OS stderr handle, so capture both stdout and stderr into asan.log.
    rem Extra args passed to run-asan.bat are forwarded to vvdecapp, e.g. -b <file>.
    > "bin\run-asan.bat" echo @echo off
    >>"bin\run-asan.bat" echo rem Auto-generated by build.bat --asan. Captures ASan report to asan.log.
    >>"bin\run-asan.bat" echo rem MSVC ASan writes to OS stderr handle; redirect 2^>^&1 here to capture it.
    >>"bin\run-asan.bat" echo rem Usage: run-asan.bat [vvdecapp args, e.g. -b bitstream.265]
    >>"bin\run-asan.bat" echo cd /d "%%~dp0"
    >>"bin\run-asan.bat" echo echo [run-asan] launching vvdecapp.exe, report -^> asan.log
    >>"bin\run-asan.bat" echo vvdecapp.exe %%* ^>asan.log 2^>^&1
    >>"bin\run-asan.bat" echo echo [run-asan] exit code %%ERRORLEVEL%%
    >>"bin\run-asan.bat" echo echo Report: %%~dp0asan.log
    >>"bin\run-asan.bat" echo pause
    echo [ASan] Generated run-asan.bat -^> bin\
)

echo.
echo === vvdec build done ===
echo Output: %BUILD_DIR%\vvdecLib.dll
if "%ASAN%"=="1" (
    echo Test:   %BUILD_DIR%\bin\run-asan.bat ^(double-click to run^)
    echo Report: %BUILD_DIR%\bin\asan.log
)
pause
